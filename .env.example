# --- Database ---------------------------------------------------------------
# Local dev uses PGlite: real Postgres compiled to WASM, running in-process.
# Nothing to install and nothing to start — the data directory is created on
# first use and gitignored.
DATABASE_URL="file:./.data/jfk"
#
# Production (Neon, Supabase, or any Postgres 15+):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-replace-me-before-any-real-money"

# --- Email (Resend) ---------------------------------------------------------
# Leave RESEND_API_KEY empty in development: OTP codes are logged to the
# terminal instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="JFK <noreply@jfk.local>"

# --- Paystack (Phase 3) -----------------------------------------------------
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- On-chain (Base Sepolia) -----------------------------------------------
# Optional: a private RPC for Base Sepolia. The public endpoint is used if empty.
# BASE_RPC_URL=
# The app wallet that pays fees for starting groups on-chain. Testnet only.
# Generate one with: cast wallet new   (then fund it with a little test ETH)
# RELAYER_PRIVATE_KEY=
