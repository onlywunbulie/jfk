{
  "name": "jfk-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\" && pnpm db:migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.mts",
    "webhook:replay": "tsx scripts/replay-webhook.mts",
    "simulate": "node --conditions=react-server --import tsx scripts/simulate.mts",
    "jobs": "node --conditions=react-server --import tsx scripts/jobs.mts"
  },
  "dependencies": {
    "@base-org/account": "^2.5.13",
    "@electric-sql/pglite": "^0.5.4",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.104.5",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "^2.57.8",
    "wagmi": "^3.7.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1"
}
